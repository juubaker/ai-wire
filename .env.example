# Copy to .env.local — that file is gitignored and never reaches the browser.
# You only need a key for the providers you actually use.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# Ollama needs no key. Point this elsewhere to use a remote runtime.
OLLAMA_BASE_URL=http://localhost:11434

# Minutes between automatic checks while "Watch for updates" is on.
VITE_WIRE_POLL_MINUTES=5

# feed   — read the shared feed a scheduled job built (production default)
# direct — call a provider live through the local proxy (dev default)
VITE_WIRE_MODE=direct

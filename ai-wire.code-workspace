{
  "folders": [{ "name": "ai-wire", "path": "." }],
  "settings": {
    "window.title": "ai wire — ${activeEditorShort}",
    "workbench.editor.labelFormat": "medium",
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "package.json": "package-lock.json, vite.config.js, tailwind.config.js, postcss.config.js, .env*, .gitignore",
      "README.md": "LICENSE*"
    },
    "terminal.integrated.cwd": "${workspaceFolder}"
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "bradlc.vscode-tailwindcss"
    ]
  }
}

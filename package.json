{
  "name": "ai-wire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A live changelog wire for LLM systems work — primary sources only.",
  "scripts": {
    "dev": "vite",
    "dev:feed": "VITE_WIRE_MODE=feed VITE_FEED_URL=/feed.json vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload",
    "cf:kv": "wrangler kv namespace create WIRE",
    "cf:tail": "wrangler tail",
    "cf:check": "wrangler dev --test-scheduled",
    "check": "node scripts/check.mjs",
    "build:pages": "VITE_BASE=/ai-wire/ VITE_WIRE_MODE=feed VITE_FEED_URL=feed.json vite build",
    "demo": "node demo/build-artifact.mjs",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "verify": "npm run lint && npm test && npm run build",
    "preview:pages": "npm run build:pages && vite preview --base /ai-wire/",
    "build:vercel": "VITE_BASE=/ai-wire/ vite build --outDir dist/ai-wire",
    "preview:vercel": "npm run build:vercel && vite preview --outDir dist"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "license": "MIT",
  "author": "John William Baker",
  "repository": {
    "type": "git",
    "url": "https://github.com/juubaker/ai-wire.git"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260923.1": true
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/feed.js": {
      "includeFiles": "public/feed.json"
    }
  },
  "crons": [
    {
      "path": "/api/cron/check",
      "schedule": "0 13 * * *"
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    { "source": "/ai-wire", "destination": "https://wire.dashboy.ai/ai-wire/" },
    { "source": "/ai-wire/", "destination": "https://wire.dashboy.ai/ai-wire/" },
    { "source": "/ai-wire/:path+", "destination": "https://wire.dashboy.ai/ai-wire/:path+" },
    { "source": "/api/:path*", "destination": "https://wire.dashboy.ai/api/:path*" }

  ]
}

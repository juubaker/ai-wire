{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/feed.js": {
      "includeFiles": "public/feed.json"
    }
  },
  "crons": [
    {
      "path": "/api/cron/check",
      "schedule": "0 13 * * *"
    }
  ],
 "rewrites": [
    {
      "source": "/ai-wire/:path*",
      "destination": "https://ai-wire-project.vercel.app/ai-wire/:path*"
    }
  ]
}

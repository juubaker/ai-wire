{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/feed.js": {
      "includeFiles": "public/feed.json"
    }
  },
  "crons": [
    {
      "path": "/api/cron/check",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
      "source": "/ai-wire/:path*", "destination": "https://ai-wire-gu8xbbk0v-surging.vercel.app/:path*" 
  ]
}
